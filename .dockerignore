# The build context is the repository root for both images. Neither needs the
# charts, the docs or the proving ground, and the agent does not need the gate.
local/
charts/
ci/
docs/
adr/
hack/
scripts/
.github/
# The documentation site. ~40MB of node_modules and a static build, none of
# which any image runs -- and all of which would otherwise be uploaded as build
# context on every image build.
site/
*.md
LICENSE
.git

# `go build` with no -o drops the binary next to the source.
/bosun
/gate/gitops-gate
