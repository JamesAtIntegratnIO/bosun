{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bosun values",
  "type": "object",
  "description": "Strict at the top level as well as inside every object. A key this chart does not know is a typo, and the typo that matters is the one that silently leaves a default-on feature on or an egress rule unapplied: `livereads` validates cleanly and disables nothing.",
  "additionalProperties": false,
  "required": [
    "image",
    "git",
    "llm",
    "triage"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm injects this into every chart in a release. Never read here; enumerated so a parent chart's global values still validate."
    },
    "enabled": {
      "type": "boolean",
      "description": "Not read by this chart. A parent chart with `condition: bosun.enabled` sets it, and the key arrives here."
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the credentials reach the process.",
      "properties": {
        "mountAsFiles": {
          "type": "boolean",
          "description": "Project each credential into a read-only file and set the _FILE variant, instead of a secretKeyRef into an environment variable that kubectl exec, /proc, a crash dump and every child process can read. Needs an image whose agent reads the _FILE variants."
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "owner",
        "repo",
        "repoURL",
        "existingSecret"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitea",
            "gitlab",
            "bitbucket"
          ]
        },
        "apiBase": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "repoURL": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "This chart never creates a Secret; supply one."
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        },
        "insecureSkipTLSVerify": {
          "type": "boolean"
        },
        "app": {
          "type": "object",
          "description": "Authenticate as a GitHub App, so the agent has an identity of its own.",
          "properties": {
            "appId": {
              "type": "string"
            },
            "installationId": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "privateKeyKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ],
          "description": "No default: a chart that silently spends money against a vendor you did not choose is a bad default."
        },
        "baseURL": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string"
        },
        "timeout": {
          "type": "string",
          "pattern": "^\\d+[smh]$|^\\d+[hm]\\d+[ms]$|^\\d+h\\d+m\\d+s$"
        },
        "existingSecret": {
          "type": "string"
        },
        "apiKeyKey": {
          "type": "string"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkName": {
          "type": "string",
          "minLength": 1
        },
        "poll": {
          "type": "string",
          "pattern": "^\\d+[smh]$|^\\d+[hm]\\d+[ms]$|^\\d+h\\d+m\\d+s$"
        },
        "forkPRs": {
          "type": "boolean"
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "validate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "ignoreMissingSchemas": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "schemaLocations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "skipKinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseURL",
            "existingSecret"
          ],
          "properties": {
            "baseURL": {
              "type": "string",
              "minLength": 1
            },
            "podPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "tokenKey": {
              "type": "string",
              "minLength": 1
            },
            "caSecret": {
              "type": "string"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            },
            "insecureSkipTLSVerify": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "argocd"
      ]
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowPaths"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "allowPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Empty means the agent can fix nothing; the process refuses to start."
        },
        "denyPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Added to the built-in deny-list, which cannot be removed from."
        },
        "explainGreen": {
          "type": "boolean",
          "description": "Explain a green gate whose render still changed."
        },
        "migrateDroppedVersions": {
          "type": "boolean",
          "description": "Deterministically migrate manifests off CRD versions a bump stops serving, when that is the gate's only blocking finding."
        },
        "upstreamNotes": {
          "type": "object",
          "description": "Read upstream release notes to explain why a bump changed the render.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxReleases": {
              "type": "integer",
              "minimum": 1
            },
            "maxBodyChars": {
              "type": "integer",
              "minimum": 200
            },
            "maxCommits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Upstream commits between the two tags that may reach a prompt or comment. Read only on escalation paths."
            }
          }
        },
        "structuralMigration": {
          "type": "boolean",
          "description": "The schema-guided repairs: a document the target CRD schema no longer accepts after an apiVersion swap, and values a new chart version refuses outright. The model is shown the schemas and what it returns is validated, and for values also rendered, before anything is written. Needs liveReads and registry egress; degrades to the plain swap without them."
        },
        "migrateMaxDocs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "Documents reshaped per pull request. Past it the remainder is escalated."
        },
        "egressDeny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Hosts the agent must not contact. Exact host or *.suffix; a pattern also forbids the apex."
        },
        "egressAllowPrivate": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Private networks the agent may reach after all, as a CIDR or a single address. Loopback, link-local, RFC1918, CGNAT and the IPv6 equivalents are refused at the dial whatever the NetworkPolicy permits; this is how a chart repository or registry on your own network is named."
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "flavor": {
          "enum": [
            "standard",
            "cilium"
          ]
        },
        "kargoNamespace": {
          "type": "string",
          "minLength": 1
        },
        "kargoPodSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels the Kargo controller's pods carry, ANDed with the namespace on the ingress rule. Empty admits every pod in that namespace, which is what a namespaceSelector alone means."
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dnsNamespace": {
              "type": "string"
            },
            "dnsPodSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Labels the cluster resolver's pods carry, ANDed with dnsNamespace. This is the only rule that opens 53, and it is what keeps a chart's `getHostByName` inside a resolver you run. Wrong labels drop every name lookup."
            },
            "ipBlocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cidr",
                  "port"
                ],
                "properties": {
                  "cidr": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                }
              }
            },
            "fqdns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowPublicHTTPS": {
              "type": "boolean"
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ports": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "fqdnPatterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "apiServer": {
              "type": "object",
              "additionalProperties": false,
              "description": "Egress to the Kubernetes apiserver, needed only with liveReads. A ClusterIP cannot be an ipBlock; give the endpoints the kubernetes Service points at. Not needed with flavor 'cilium'.",
              "properties": {
                "ipBlocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cidr"
                    ],
                    "properties": {
                      "cidr": {
                        "type": "string"
                      },
                      "port": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            },
            "allowInternet": {
              "type": "boolean",
              "description": "Let the agent reach the internet on 443. Every outbound request is logged; forbid hosts with triage.egressDeny."
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^\\d+[smh]$|^\\d+[hm]\\d+[ms]$|^\\d+h\\d+m\\d+s$"
            },
            "namespace": {
              "type": "string",
              "description": "The namespace Prometheus scrapes from. Required with networkPolicy.enabled: the scrape's ingress rule is otherwise a pod label alone, and a pod label is chosen by whoever creates the pod."
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "mark": {
          "type": "string"
        }
      }
    },
    "liveReads": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read the cluster, read-only, so briefs can say what is running and not only what the repository declares.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "enum": [
            "groups",
            "wide"
          ],
          "description": "groups: only the API groups listed, so Secrets stay unreadable. wide: apiGroups ['*'], which answers everything and can read Secret contents, because RBAC cannot subtract the core group."
        },
        "apiGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "API groups the agent may count objects in, when scope is 'groups'."
        },
        "argocdNamespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supervise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^\\d+[smh]$|^\\d+[hm]\\d+[ms]$|^\\d+h\\d+m\\d+s$"
        }
      }
    },
    "promotionAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string"
        }
      }
    },
    "maxConcurrentTriage": {
      "type": "integer",
      "minimum": 1
    }
  }
}
